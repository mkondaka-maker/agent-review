# Optional: PostgreSQL / Supabase connection string (falls back to CSV if not set)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# REQUIRED: Google Gemini API key for the AI Financial Review section.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Optional: Anthropic API key (used as fallback if Gemini fails)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: path to your CSV if it's not at data/Financial_Statements.csv
FINANCIAL_CSV_PATH=../data/Financial_Statements.csv

# Optional: backend port
PORT=5000
