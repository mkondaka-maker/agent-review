# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Groq API Key (Primary LLM Provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Alternative: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Alternative: OpenRouter API Key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Alternative: OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: path to your CSV if it's not at data/Financial_Statements.csv
FINANCIAL_CSV_PATH=../data/Financial_Statements.csv

# Optional: backend port
PORT=5000
